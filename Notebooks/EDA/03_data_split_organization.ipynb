 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 03 - Split and Organize Dataset (70/15/15 stratified)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import train_test_split\n",
    "import sys\n",
    "sys.path.append('../../src')\n",
    "from yolov8_tumor_detection.data_utils import validate_yolo_label\n",
    "\n",
    "raw = Path('../../Data/Raw')\n",
    "# rebuild valid pairs\n",
    "images = []\n",
    "labels = []\n",
    "for p in raw.rglob('*'):\n",
    "    if p.is_file():\n",
    "        ext = p.suffix.lower()\n",
    "        if ext in ['.jpg','.jpeg','.png','.bmp']:\n",
    "            images.append(p)\n",
    "        elif ext == '.txt':\n",
    "            labels.append(p)\n",
    "label_map = {l.stem:l for l in labels}\n",
    "img_map = {i.stem:i for i in images}\n",
    "rows = []\n",
    "for stem, img in img_map.items():\n",
    "    if stem not in label_map: continue\n",
    "    lab = label_map[stem]\n",
    "    v = validate_yolo_label(lab, nc=4)\n",
    "    if v is None: continue\n",
    "    if len(v) == 0:\n",
    "        cls = 3  # No Tumor\n",
    "    else:\n",
    "        cls = v[0][0]\n",
    "    rows.append({'image_path': str(img), 'label_path': str(lab), 'cls': cls})\n",
    "df = pd.DataFrame(rows)\n",
    "print(len(df))\n",
    "df['cls'].value_counts()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# split 70/15/15 stratified\n",
    "seed = 42\n",
    "train_df, temp = train_test_split(df, test_size=0.3, stratify=df['cls'], random_state=seed)\n",
    "val_df, test_df = train_test_split(temp, test_size=0.5, stratify=temp['cls'], random_state=seed)\n",
    "train_df['split']='train'; val_df['split']='val'; test_df['split']='test'\n",
    "all_df = pd.concat([train_df, val_df, test_df])\n",
    "print(len(train_df), len(val_df), len(test_df))\n",
    "all_df.groupby('split')['cls'].value_counts()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# copy\n",
    "import shutil\n",
    "out = Path('../../data/processed')\n",
    "for _, row in all_df.iterrows():\n",
    "    s = row['split']\n",
    "    ip = Path(row['image_path']); lp = Path(row['label_path'])\n",
    "    idst = out/'images'/s/ip.name\n",
    "    ldst = out/'labels'/s/lp.name\n",
    "    idst.parent.mkdir(parents=True,exist_ok=True)\n",
    "    ldst.parent.mkdir(parents=True,exist_ok=True)\n",
    "    shutil.copy2(ip,idst)\n",
    "    shutil.copy2(lp,ldst)\n",
    "print('done')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# create data.yaml\n",
    "names = ['Glioma', 'Meningioma', 'No Tumor', 'Pituitary']\n",
    "yaml = f'''path: ./data/processed\ntrain: images/train\nval: images/val\ntest: images/test\nnc: 4\nnames: {names}\n'''\n",
    "with open('../../data.yaml','w') as f:\n",
    "    f.write(yaml)\n",
    "print(yaml)"
   ]
  }
 ],
